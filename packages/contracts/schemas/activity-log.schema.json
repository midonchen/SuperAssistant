{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superassistant.local/schemas/activity-log.schema.json",
  "title": "ActivityLog",
  "type": "object",
  "required": [
    "activity_id",
    "item_key",
    "action_type",
    "operation",
    "delta_value",
    "before_value",
    "after_value",
    "timestamp"
  ],
  "properties": {
    "activity_id": { "type": "string", "format": "uuid" },
    "item_key": { "type": "string" },
    "action_type": {
      "type": "string",
      "enum": ["OCR", "VOICE", "MANUAL", "AUTO_DECAY", "CALIBRATE", "ADMIN_REVIEW"]
    },
    "operation": {
      "type": "string",
      "enum": ["ADD", "SET", "SUBTRACT", "CLEAR"]
    },
    "delta_value": { "type": "number" },
    "before_value": { "type": "number" },
    "after_value": { "type": "number" },
    "raw_text": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"] },
    "operator_role": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
