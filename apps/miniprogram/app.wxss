page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}
.page { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.row { display: flex; justify-content: space-between; align-items: center; }
.title { font-size: 32rpx; font-weight: 600; }
.badge { font-size: 26rpx; color: #666; }
.meta { font-size: 26rpx; color: #999; margin-top: 8rpx; }
.empty { text-align: center; color: #999; padding: 120rpx 0; font-size: 28rpx; }

.h2 { font-size: 34rpx; font-weight: 700; margin: 8rpx 0 16rpx; }
.h3 { font-size: 28rpx; font-weight: 600; color: #666; margin: 20rpx 0 8rpx; }
.input { background: #f0f0f5; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; font-size: 28rpx; }
.btn { background: linear-gradient(135deg, #4de0b6, #7a56fe); color: #fff; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; margin: 8rpx 0 16rpx; }
.btn::after { border: none; }
.item { padding: 14rpx 0; border-bottom: 1rpx solid #eee; }
.item .meta { display: block; color: #999; font-size: 24rpx; margin-top: 4rpx; }
.subnav { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.subnav-btn { flex: 1; background: #fff; color: #666; border-radius: 12rpx; font-size: 26rpx; }
.subnav-btn::after { border: none; }
.subnav-btn.active { background: #14b8a6; color: #fff; font-weight: 600; }
.actions { display: flex; gap: 12rpx; margin-top: 10rpx; }
.btn.mini { margin: 0; padding: 4rpx 20rpx; font-size: 24rpx; }
.btn.ghost { background: #eef0f5; color: #333; }
.subnav-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.subnav-scroll .subnav { display: inline-flex; gap: 12rpx; }
.subnav-scroll .subnav-btn { flex: none; min-width: 110rpx; }
