# SuperAssistant staging environment template.
# Copy to repo-root .env and fill in real values. NEVER commit real .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://superassistant:change-me-strong-password@postgres:5432/superassistant

# --- Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
OFFLINE_QUEUE_REDIS_URL=redis://redis:6379/2
AI_QUOTA_REDIS_URL=redis://redis:6379/3

# --- AI providers ---
STT_PROVIDER=local
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=fill-in-on-server-only
DEEPSEEK_MODEL=deepseek-chat
# Optional cost guardrails (defaults are fine for staging):
# AI_PROVIDER_QPS_PER_MINUTE=60
# AI_PROVIDER_TOKEN_PER_MINUTE=100000
# AI_PROVIDER_TOKEN_PER_DAY=2000000
# AI_PARSER_BREAKER_MAX_FAILURES=5
# AI_PARSER_BREAKER_COOLDOWN_SECONDS=60
# AI_STT_BREAKER_MAX_FAILURES=5
# AI_STT_BREAKER_COOLDOWN_SECONDS=60

# --- Governance ---
SUPERASSISTANT_ADMIN_PHONES=13900139000
SUPERASSISTANT_AUDITOR_PHONES=13900139001
SUPERASSISTANT_MAX_ACTIVE_SESSIONS=3
